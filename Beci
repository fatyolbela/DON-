from kivy.app import App
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.boxlayout import BoxLayout
from kivy.core.audio import SoundLoader
from kivy.uix.popup import Popup
from kivy.uix.filechooser import FileChooserListView
from kivy.utils import platform

if platform == 'android':
    try:
        from android.permissions import request_permissions, Permission
        request_permissions([Permission.READ_EXTERNAL_STORAGE, Permission.WRITE_EXTERNAL_STORAGE, Permission.READ_MEDIA_AUDIO])
    except:
        pass

class DonPlayer(BoxLayout):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.orientation = 'vertical'
        self.sound = None
        self.padding = 15
        self.spacing = 15
        self.label = Label(text="DON PLAYER\nANDROID\nValassz zenet", halign='center', font_size=24, size_hint_y=0.4)
        self.add_widget(self.label)
        btn_load = Button(text="ZENE BETOLTESE", background_color=(0.2, 0.8, 0.2, 1), size_hint_y=0.25, font_size=22, bold=True)
        btn_load.bind(on_press=self.load)
        self.add_widget(btn_load)
        btn_stop = Button(text="STOP", background_color=(0.9, 0.2, 0.2, 1), size_hint_y=0.25, font_size=20)
        btn_stop.bind(on_press=self.stop)
        self.add_widget(btn_stop)
    def load(self, instance):
        content = BoxLayout(orientation='vertical')
        start_path = '/storage/emulated/0/Music' if platform == 'android' else '/'
        filechooser = FileChooserListView(path=start_path, filters=['*.mp3','*.wav','*.ogg','*.m4a','*.MP3'])
        btn_select = Button(text="LEJATSZAS", size_hint_y=0.2, background_color=(0.2, 0.6, 1, 1), font_size=20)
        content.add_widget(filechooser)
        content.add_widget(btn_select)
        popup = Popup(title="Valassz zenet - /Music mappa", content=content, size_hint=(0.95, 0.9))
        def select_file(btn):
            if filechooser.selection:
                self.play_music(filechooser.selection[0])
                popup.dismiss()
        btn_select.bind(on_press=select_file)
        popup.open()
    def play_music(self, path):
        if self.sound:
            self.sound.stop()
        self.sound = SoundLoader.load(path)
        if self.sound:
            self.sound.play()
            name = path.split('/')[-1]
            self.label.text = f"DON PLAYER\n\nMost szol:\n{name}"
    def stop(self, instance):
        if self.sound:
            self.sound.stop()
            self.label.text = "DON PLAYER\nANDROID\nValassz zenet"
class DonApp(App):
    def build(self):
        from kivy.core.window import Window
        Window.clearcolor = (0.05, 0.05, 0.08, 1)
        return DonPlayer()
